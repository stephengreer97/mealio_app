{
  "expo": {
    "name": "Mealio",
    "slug": "mealio",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mealio",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#DD0031"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.mealio.app",
      "associatedDomains": [
        "applinks:mealio.co"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "heb",
          "kroger",
          "harristeeter",
          "kingsoopers",
          "fredmeyer",
          "ralphs",
          "smithsfoodanddrug",
          "frysfood",
          "marianos",
          "picknsave",
          "dillons",
          "bakersplus",
          "citymarket",
          "payless",
          "metromarket",
          "carrs",
          "qfc"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.mealio.app",
      "adaptiveIcon": {
        "backgroundColor": "#DD0031",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mealio.co",
              "pathPrefix": "/meal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mealio uses your photo library so you can add a custom photo to your saved meals."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "de837933-902a-4e7b-ac42-6dafbdec0faa"
      }
    }
  }
}
