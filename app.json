{
  "expo": {
    "name": "Mealio",
    "slug": "mealio",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mealio",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.mealio.app",
      "associatedDomains": [
        "applinks:mealio.co"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "myheb"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.mealio.app",
      "adaptiveIcon": {
        "backgroundColor": "#DD0031",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mealio.co",
              "pathPrefix": "/meal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Mealio uses your photo library so you can add a custom photo to your saved meals.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DD0031",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "ios": {
            "enableFullScreenImage_legacy": true,
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#DD0031",
            "resizeMode": "contain"
          },
          "android": {
            "image": "./assets/android-splash-icon.png",
            "imageWidth": 220,
            "backgroundColor": "#DD0031",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.814745050237-ar27stkk3ppa4e1dju1uqgthqts947t6"
        }
      ],
      "./plugins/withModularHeaders",
      "./plugins/withWebViewTrustAnchors"
    ],
    "extra": {
      "eas": {
        "projectId": "de837933-902a-4e7b-ac42-6dafbdec0faa"
      }
    }
  }
}
