{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "channel": "preview"
    },
    "ios-simulator": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_E2E": "1",
        "EXPO_PUBLIC_MOCK_STORE_URL": "https://mealiomockstore.vercel.app"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761012560"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
